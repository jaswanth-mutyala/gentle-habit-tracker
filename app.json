{
  "expo": {
    "name": "Gentle - Daily Habit Tracker",
    "slug": "gentle-habit-tracker",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gentlehabits.app",
      "buildNumber": "1.0.1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "NSCriticalAlertUsageDescription": "Gentle uses critical alerts to ensure you never miss a habit reminder, even when Do Not Disturb is on.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gentlehabits.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5F0"
      },
      "permissions": [
        "com.android.vending.BILLING",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7D9B76",
          "sounds": [
            "./assets/sounds/gentle-chime.wav"
          ]
        }
      ],
      [
        "expo-secure-store",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a67854af-3800-4c19-bb1e-1b0747fec601"
      }
    }
  }
}
